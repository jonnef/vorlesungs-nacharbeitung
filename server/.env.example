# Kopieren nach server/.env und ausfüllen.
# Eigener API-Key aus einem eigenen Workspace mit Spend-Limit (siehe README).
ANTHROPIC_API_KEY=sk-ant-...
# Zufälliger Token für den Mac-Watcher, z. B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Optional: Passwort für die Weboberfläche (Benutzername beliebig)
WEB_PASSWORD=

CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
MAX_OUTPUT_TOKENS=20000
SCRIPT_CONTEXT_TOKENS=60000
MONTHLY_BUDGET_USD=10
# 1 = Jobs automatisch starten, wenn sie ins Budget passen; 0 = jeden Job per Klick freigeben
AUTO_SUBMIT=1
