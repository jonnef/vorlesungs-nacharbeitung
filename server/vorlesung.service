# systemd-Dienst für den Raspberry Pi.
# Installation: sudo cp vorlesung.service /etc/systemd/system/ && sudo systemctl enable --now vorlesung
[Unit]
Description=Vorlesungs-Nacharbeitung (Web-App)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/vorlesungs-nacharbeitung/server
ExecStart=/home/pi/vorlesungs-nacharbeitung/server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
